{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dear-passengers-flight-rooms",
  "main": "index.ts",
  // Installed workerd rejects 2026-10-04; 2026-07-21 is its reported maximum.
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "FLIGHT_ROOMS", "class_name": "FlightRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlightRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://dearpassengers.net,https://www.dearpassengers.net"
  },
  "observability": { "enabled": false }
}
