{
  "name": "dear-passengers-guide",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Dear Passengers game, gameplay, and release-date guide for dearpassengers.net",
  "scripts": {
    "dev": "next dev --turbo",
    "prebuild": "pnpm audit:facts && pnpm audit:observations",
    "build": "next build && node scripts/set-static-language.mjs && node scripts/audit-adsense-build.mjs",
    "start": "next start",
    "preview:cf": "wrangler pages dev out",
    "deploy:cf": "pnpm build && wrangler pages deploy out --project-name dear-passengers --branch main",
    "audit:facts": "node scripts/audit-game-facts.mjs",
    "audit:observations": "node scripts/audit-launch-observations.mjs",
    "audit:seo-page": "node scripts/audit-seo-page.mjs",
    "audit:adsense": "node scripts/audit-adsense-build.mjs",
    "create:observation": "node scripts/create-launch-observation.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "framer-motion": "^12.36.0",
    "geist": "^1.2.0",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "eslint": "8.56.0",
    "eslint-config-next": "^14.0.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.112.0"
  }
}
